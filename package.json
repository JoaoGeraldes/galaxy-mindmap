{
  "name": "galaxy-mindmap",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "electron . --dev",
    "dev:web": "vite",
    "build": "vite build",
    "site": "npm run site:build && vite site",
    "site:build": "vite build --outDir site/app --emptyOutDir && node -e \"require('fs').copyFileSync('src/assets/logo.svg', 'site/logo.svg')\"",
    "start": "vite build && electron .",
    "test": "vitest run",
    "check": "svelte-check && prettier --check . && vitest run"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@tsconfig/svelte": "^5.0.0",
    "electron": "^38.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-svelte": "^3.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.5.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
